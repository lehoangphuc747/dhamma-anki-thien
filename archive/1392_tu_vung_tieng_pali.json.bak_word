    "id": "Pali - 1279",
    "pali": "Ācariya",
    "vietnamese": "thầy/cô, thiền sư, người hướng dẫn.",
    "explain": ""
  },
  {
    "id": "Pali - 1280",
    "pali": "Adhiṭṭhāna",
    "vietnamese": "quyết tâm mạnh mẽ. Một trong mười pāramī, phẩm hạnh (Ba la Mật).",
    "explain": ""
  },
  {
    "id": "Pali - 1281",
    "pali": "Akusala",
    "vietnamese": "bất thiện, có hại. Trái nghĩa kusala.",
    "explain": ""
  },
  {
    "id": "Pali - 1282",
    "pali": "Ānanda",
    "vietnamese": "vui sướng, hạnh phúc, hỷ.",
    "explain": ""
  },
  {
    "id": "Pali - 1283",
    "pali": "Ānāpāna",
    "vietnamese": "hô hấp, hơi thở. Ānāpāna-sati: ý thức về hơi thở, (niệm hơi thở).",
    "explain": ""
  },
  {
    "id": "Pali - 1284",
    "pali": "Anattā",
    "vietnamese": "vô ngã, không có cái ta, không có thực chất, không có thực thể. Một trong ba đặc tính căn bản. Xem lakkhaṇa.",
    "explain": ""
  },
  {
    "id": "Pali - 1285",
    "pali": "Anicca",
    "vietnamese": "vô thường, phù du, thay đổi. Một trong ba đặc tính căn bản. Xem lakkhaṇa.",
    "explain": ""
  },
  {
    "id": "Pali - 1286",
    "pali": "Arahant",
    "vietnamese": "người đã giải thoát (A-la-hán); người đã diệt hết mọi bất tịnh trong tâm mình. Xem Buddha.",
    "explain": ""
  },
  {
    "id": "Pali - 1287",
    "pali": "Ariya",
    "vietnamese": "thánh thiện; bậc thánh, thánh nhân. Người đã thanh lọc tâm tới mức đã chứng nghiệm được sự thật tối hậu (nibbāna). Có bốn cấp độ ariya, từ sotāpanna (\"thánh nhập lưu\"), người sẽ tái sinh tối đa bảy kiếp, cho tới arahant, người sẽ không còn tái sinh sau kiếp hiện tại.",
    "explain": ""
  },
  {
    "id": "Pali - 1288",
    "pali": "Ariya Aṭṭhaṅgika Magga",
    "vietnamese": "Bát Chánh Đạo hay Bát Thánh Đạo. Xem magga.",
    "explain": ""
  },
  {
    "id": "Pali - 1289",
    "pali": "Ariya Sacca",
    "vietnamese": "Sự Thật Thánh Thiện (Diệu Đế). Xem Sacca.",
    "explain": ""
  },
  {
    "id": "Pali - 1290",
    "pali": "Asubha",
    "vietnamese": "bất tịnh, đáng ghê sợ, không đẹp. Trái nghĩa với subha, thanh tịnh, tinh khiết, đẹp.",
    "explain": ""
  },
  {
    "id": "Pali - 1291",
    "pali": "Assutavā/Assutavant",
    "vietnamese": "không được chỉ dạy, phàm phu; người chưa bao giờ được nghe dạy về chân lý, người thiếu ngay cả suta-mayā paññā, và do đó không thể dẫn bước trên con đường giải thoát. Trái nghĩa với sutavā.",
    "explain": ""
  },
  {
    "id": "Pali - 1292",
    "pali": "Avijjā",
    "vietnamese": "vô minh, ảo tưởng, lầm lạc. Mắt xích đầu tiên trong Chuỗi Duyên Khởi / Chuỗi Thập Nhị (12) Nhân Duyên / Lý Duyên Khởi (paṭicca samuppāda). Cùng với tham (rāga) và sân (dosa), si là một trong ba phiền não căn bản trong tâm. Ba loại phiền não này là nguyên nhân gốc rễ của mọi bất tịnh khác và do đó là nguyên nhân đưa đến khổ đau. Đồng nghĩa với moha.",
    "explain": ""
  },
  {
    "id": "Pali - 1293",
    "pali": "Āyatana",
    "vietnamese": "phạm vi, lĩnh vực, đặc biệt là sáu lĩnh vực cảm nhận (lục căn) (saḷāyatana), nghĩa là: năm giác quan cộng với tâm, và các đối tượng tương ứng của chúng (lục trần), cụ thể là: mắt (cakkhu) và cảnh sắc (rūpa); tai (sota) và âm thanh (sadda); mũi (ghāna) và mùi (gandha); lưỡi (jivhā) và vị (rasa); thân (kāya) và xúc chạm (phoṭṭhabba); tâm (mano) và đối tượng của tâm, nghĩa là các loại ý nghĩ (dhamma). Đây còn được gọi là sáu giác quan. Xem indriya.",
    "explain": ""
  },
  {
    "id": "Pali - 1294",
    "pali": "Bala",
    "vietnamese": "sức mạnh, hùng lực (lực). Năm sức mạnh tinh thần là niềm tin (saddhā), nỗ lực (viriya), ý thức (sati), định (samādhi), trí tuệ (paññā). Dưới hình thức phát triển thấp hơn, đây được gọi là năm khả năng/năng lực. Xem indriya.",
    "explain": ""
  },
  {
    "id": "Pali - 1295",
    "pali": "Bhanga",
    "vietnamese": "(trạng thái) tan rã. Một giai đoạn quan trọng trong sự tu tập Vipassana, chứng nghiệm được sự tan rã của trạng thái bề ngoài dường như chắc đặc của thân ra thành những rung động vi tế vốn luôn sinh và diệt.",
    "explain": ""
  },
  {
    "id": "Pali - 1296",
    "pali": "Bhava",
    "vietnamese": "(tiến trình) hình thành. Bhava-cakka: vòng luân hồi, bánh xe luân hồi. Xem cakka.",
    "explain": ""
  },
  {
    "id": "Pali - 1297",
    "pali": "Bhāvanā",
    "vietnamese": "phát triển trí tuệ, thiền. Hai phần được chia ra của bhāvanā là sự phát triển trạng thái tĩnh lặng / thiền tĩnh lặng, (samatha-bhāvanā), tương ứng với định tâm, (samādhi) (thiền chỉ, thiền định), và sự phát triển tuệ giác (vipassanā-bhāvanā) (thiền quán/thiền tuệ), tương ứng với trí tuệ (paññā). Việc phát triển samatha sẽ đưa tới các trạng thái nhập định jhāna; việc phát triển vipassanā sẽ đưa tới giải thoát. Xem jhāna, paññā, samādhi, vipassanā.",
    "explain": ""
  },
  {
    "id": "Pali - 1298",
    "pali": "Bhāvanā-Mayā Paññā",
    "vietnamese": "trí tuệ phát triển nhờ kinh nghiệm trực tiếp của bản thân, tuệ giác, tuệ thực chứng (tu tuệ). Xem paññā.",
    "explain": ""
  },
  {
    "id": "Pali - 1299",
    "pali": "Bhavatu Sabba Maṅgalaṃ",
    "vietnamese": "\"Nguyện cho tất cả chúng sinh được hạnh phúc\". Một câu nói truyền thống dùng để diễn tả thiện ý đối với người khác. (Nghĩa đen, \"Nguyện cho luôn có hạnh phúc ở mọi nơi\")",
    "explain": ""
  },
  {
    "id": "Pali - 1300",
    "pali": "Bhikkhu",
    "vietnamese": "(Phật giáo) tăng sĩ; thiền giả, tỳ kheo. Bhikkhunī: tỳ kheo ni, ni, sư cô.",
    "explain": ""
  },
  {
    "id": "Pali - 1301",
    "pali": "Bodhi",
    "vietnamese": "sự giác ngộ.",
    "explain": ""
  },
  {
    "id": "Pali - 1302",
    "pali": "Bodhisatta",
    "vietnamese": "nghĩa đen, \"Bậc đang giác ngộ\" (Bồ Tát). Người đang tu tập để trở thành Phật. Dùng để chỉ Siddhattha Gotama trong khoảng thời gian trước khi Ngài đạt đến sự giác ngộ hoàn toàn. Tiếng Sanskrit: bodhisattva.",
    "explain": ""
  },
  {
    "id": "Pali - 1303",
    "pali": "Bojjhaṅga",
    "vietnamese": "nhân tố giác ngộ (thất giác chi), nghĩa là phẩm chất/tổ chất giúp ta đạt được sự giác ngộ. Bảy nhân tố này là ý thức (niệm) (sati), nghiên cứu thấu triệt về Dhamma (Dhamma-vicaya) (trạch pháp), tinh tấn (viriya), vui mừng (hỷ) (pīti), an tĩnh (khinh an) (passadhi), định tâm (samādhi), tâm xả (upekkhā).",
    "explain": ""
  },
  {
    "id": "Pali - 1304",
    "pali": "Brahmacariya",
    "vietnamese": "độc thân/tịnh thân/không quan hệ tình dục; một cuộc sống trong sạch và thánh thiện.",
    "explain": ""
  },
  {
    "id": "Pali - 1305",
    "pali": "Brahmā",
    "vietnamese": "sinh linh cư trú ở những cõi trời cao hơn, phạm thiên; từ dùng trong Ấn giáo để chỉ chúng sinh cao nhất trong mọi loài chúng sinh, thường để chỉ Đấng Tạo Hóa - Thượng đế toàn năng, nhưng Đức Phật nêu rõ là họ cũng chịu sự suy thoái và cái chết như mọi chúng sinh.",
    "explain": ""
  },
  {
    "id": "Pali - 1306",
    "pali": "Brahma-Vihāra",
    "vietnamese": "bản chất của brahmā, đó là trạng thái tâm siêu phàm hay thánh thiện, trong đó có bốn phẩm chất thanh tịnh hiện diện là: tâm từ (từ) (mettā), thương xót (bi) (karuṇā), mừng vui với hạnh phúc của người khác (hỷ) (muditā), buông xả trong mọi hoàn cảnh (xả) (upekkhā); sự tu dưỡng có phương pháp bốn phẩm chất này bằng cách thực hành thiền.",
    "explain": ""
  },
  {
    "id": "Pali - 1307",
    "pali": "Brāhmaṇa",
    "vietnamese": "nghĩa đen, một người trong sạch (Bà-la-môn). Thời xưa dùng để chỉ một người thuộc tầng lớp tu sĩ tại Ấn Độ. Người đó dựa vào một vị thần (Brahmā) để được \"cứu rỗi\" hoặc giải thoát cho mình; theo đường lối này họ khác với samaṇa. Đức Phật định rõ một brāhmaṇa đúng nghĩa là người đã thanh lọc được tâm mình, nghĩa là bậc arahant.",
    "explain": ""
  },
  {
    "id": "Pali - 1308",
    "pali": "Buddha",
    "vietnamese": "bậc giác ngộ, Đức Phật, người đã khám phá ra con đường giải thoát, đã thực hành, và đã đạt đến đích bằng nỗ lực của bản thân. Có hai hạng Phật: 1) pacceka-buddha, Phật Độc Giác, vị Phật \"đơn độc\" hay \"thầm lặng\", vị không thể chỉ dạy cho người khác con đường mình đã tìm thấy. 2) sammā-sambuddha, Phật Toàn Giác, vị Phật \"hoàn chỉnh\" hay \"hoàn hảo\", vị có thể chỉ dạy cho người khác.",
    "explain": ""
  },
  {
    "id": "Pali - 1309",
    "pali": "Cakka",
    "vietnamese": "bánh xe, Bhava-cakka, bánh xe luân hồi (nghĩa là tiến trình khổ đau), tương đương với saṃsāra. Dhamma-cakka, bánh xe Dhamma (nghĩa là giáo pháp hoặc tiến trình giải thoát). Bhava-cakka tương ứng với Chuỗi Duyên Khởi theo chiều thuận. Dhamma-cakka tương ứng với Chuỗi này theo chiều ngược lại, đưa tới diệt trừ thay vì gia tăng khổ đau.",
    "explain": ""
  },
  {
    "id": "Pali - 1310",
    "pali": "Cintā-Mayā-Paññā",
    "vietnamese": "trí tuệ đạt được nhờ suy luận, tuệ tư duy (tư tuệ). Xem paññā.",
    "explain": ""
  },
  {
    "id": "Pali - 1311",
    "pali": "Citta",
    "vietnamese": "tâm. Cittānupassanā, quan sát tâm. Xem satipaṭṭhāna.",
    "explain": ""
  },
  {
    "id": "Pali - 1312",
    "pali": "Dāna",
    "vietnamese": "hiến tặng, sự hào phóng, đóng góp thiện nguyện, (cúng dường). Một trong mười pāramī.",
    "explain": ""
  },
  {
    "id": "Pali - 1313",
    "pali": "Dhamma",
    "vietnamese": "hiện tượng, đối tượng của tâm (pháp); tự nhiên, luật tự nhiên, luật giải thoát, nghĩa là giáo pháp của bậc giác ngộ. Dhammānupassanā, quan sát nội dung của tâm. Xem satipaṭṭhāna. (Tiếng Sanskrit dharma).",
    "explain": ""
  },
  {
    "id": "Pali - 1314",
    "pali": "Dhātu / Dhatu",
    "vietnamese": "nguyên tố (xem mahā-bhūtāni); điều kiện tự nhiên, tính chất.",
    "explain": ""
  },
  {
    "id": "Pali - 1315",
    "pali": "Dosa",
    "vietnamese": "tâm sân, không ưa thích, ghét. Cùng với rāga và moha, một trong ba phiền não chính của tâm.",
    "explain": ""
  },
  {
    "id": "Pali - 1316",
    "pali": "Dukkha",
    "vietnamese": "khổ, sự không hài lòng. Một trong ba đặc tính căn bản (xem lakkhaṇa). Sự Thật Thánh Thiện Thứ Nhất (Khổ Đế) (xem sacca).",
    "explain": ""
  },
  {
    "id": "Pali - 1317",
    "pali": "Gotama",
    "vietnamese": "họ của vị Phật có trong lịch sử. (Tiếng Sanskrit Gautama).",
    "explain": ""
  },
  {
    "id": "Pali - 1318",
    "pali": "Hīnayāna",
    "vietnamese": "nghĩa đen, \"chiếc xe nhỏ\" (tiểu thừa). Từ của những người theo tông phái khác dùng để chỉ Phật giáo Theravāda. Hàm ý chê bai.",
    "explain": ""
  },
  {
    "id": "Pali - 1319",
    "pali": "Indriya",
    "vietnamese": "năng lực, khả năng. Dùng trong bài này để chỉ sáu lĩnh vực cảm nhận (xem āyatana) và năm sức mạnh của tâm (ngũ lực) (xem bala).",
    "explain": ""
  },
  {
    "id": "Pali - 1320",
    "pali": "Jāti",
    "vietnamese": "sinh ra, tồn tại, hiện hữu (hữu).",
    "explain": ""
  },
  {
    "id": "Pali - 1321",
    "pali": "Jhāna",
    "vietnamese": "trạng thái nhập định, tầng thiền định. Có tám trạng thái như vậy có thể đạt được nhờ thực hành samādhi hoặc samatha-bhāvanā (xem bhāvanā). Trau dồi định mang tới sự an tĩnh và hỷ lạc, nhưng không diệt trừ được những ô nhiễm đã cắm rễ sâu trong tâm.",
    "explain": ""
  },
  {
    "id": "Pali - 1322",
    "pali": "Kalāpa / Aṭṭha-Kalāpa",
    "vietnamese": "vi tử, đơn vị nhỏ nhất, không thể chia cắt của vật chất, được cấu thành từ bốn nguyên tố cùng những đặc tính của chúng. Xem mahā-bhūtāni.",
    "explain": ""
  },
  {
    "id": "Pali - 1323",
    "pali": "Kalyāṇa-Mitta",
    "vietnamese": "nghĩa đen, \"người bạn giúp đỡ cho ai đó được tốt lành\", do đó là người hướng dẫn một người tới sự giải thoát, nghĩa là người hướng dẫn tâm linh (thiện hữu).",
    "explain": ""
  },
  {
    "id": "Pali - 1324",
    "pali": "Kamma",
    "vietnamese": "hành động, đặc biệt là một hành động nào đó được thực hiện bởi một người mà nó sẽ có ảnh hưởng đến tương lai của người ấy (nghiệp). Xem saṅkhāra. (Tiếng Sanskrit karma).",
    "explain": ""
  },
  {
    "id": "Pali - 1325",
    "pali": "Kāya",
    "vietnamese": "thân, cơ thể. Kāyānupassanā, quan sát thân (quán thân). Xem satipaṭṭhāna.",
    "explain": ""
  },
  {
    "id": "Pali - 1326",
    "pali": "Khandha",
    "vietnamese": "khối, nhóm, tập hợp (uẩn). Con người được hợp thành từ năm tập hợp (ngũ uẩn): vật chất (sắc) (rūpa), hay biết (thức) (viññāṇa), nhận biết (tưởng) (saññā), cảm nhận / cảm giác (thọ) (vedanā), phản ứng (hành) (saṅkhāra).",
    "explain": ""
  },
  {
    "id": "Pali - 1327",
    "pali": "Kilesa",
    "vietnamese": "phiền não, tiêu cực, bất tịnh trong tâm, ô nhiễm. Anusaya kilesa, phiền não tiềm ẩn, bất tịnh nằm im trong vô thức.",
    "explain": ""
  },
  {
    "id": "Pali - 1328",
    "pali": "Kusala",
    "vietnamese": "thiện, hữu ích. Trái nghĩa với akusala.",
    "explain": ""
  },
  {
    "id": "Pali - 1329",
    "pali": "Lakkhaṇa",
    "vietnamese": "dấu hiệu, đặc điểm phân biệt, đặc trưng, đặc tính. Ba đặc tính (ti-lakkhaṇa) là anicca, dukkha, anattā. Hai đặc tính đầu có ở mọi hiện tượng bị điều kiện hóa (pháp hữu vi). Đặc tính thứ ba có ở mọi hiện tượng, bị điều kiện hóa (pháp hữu vi) hay không bị điều kiện hóa (pháp vô vi).",
    "explain": ""
  },
  {
    "id": "Pali - 1330",
    "pali": "Lobha",
    "vietnamese": "tâm tham. Đồng nghĩa với rāga.",
    "explain": ""
  },
  {
    "id": "Pali - 1331",
    "pali": "Loka",
    "vietnamese": "1. thế giới vĩ mô, nghĩa là vũ trụ, thế gian, cõi có sự sống; 2. thế giới vi mô, nghĩa là cấu trúc tinh thần-vật chất. Loka-dhamma, chông gai của cuộc đời, thăng trầm trong cuộc sống mà ai cũng gặp phải, đó là được hay mất, thắng hay thua, khen hay chê, sướng hay khổ.",
    "explain": ""
  },
  {
    "id": "Pali - 1332",
    "pali": "Mahā-Bhūtāni",
    "vietnamese": "bốn nguyên tố có trong mọi vật chất: Pathavī-dhātu-nguyên tố đất (sức nặng). Āpo-dhātu-nguyên tố nước (sự kết dính). Tejo-dhātu-nguyên tố lửa (nhiệt độ). Vāyo-dhātu-nguyên tố khí (chuyển động).",
    "explain": ""
  },
  {
    "id": "Pali - 1333",
    "pali": "Maṅgala",
    "vietnamese": "phúc lợi, an vui, phước lành, hạnh phúc.",
    "explain": ""
  },
  {
    "id": "Pali - 1334",
    "pali": "Māra",
    "vietnamese": "cái chết, ma lực / quyền lực tiêu cực, ma vương.",
    "explain": ""
  },
  {
    "id": "Pali - 1335",
    "pali": "Magga",
    "vietnamese": "đường lối, con đường (Đạo). Ariya Aṭṭhaṅgika Magga, Bát Chánh Đạo đưa đến giải thoát khỏi khổ đau. Bát Chánh Đạo chia ra làm ba giai đoạn hay sự tu tập: I. Sīla, giới, đạo đức, sự trong sạch của lời nói và việc làm: i. sammā-vācā, lời nói chân chính (Chánh ngữ); ii. sammā-kammanta, hành động chân chính (Chánh nghiệp); iii. sammā-ājīva, nghề nghiệp chân chính (Chánh mạng). II. Samādhi, định, sự làm chủ tâm: iv. sammā-vāyāma, nỗ lực chân chính (Chánh tinh tấn); v. sammā-sati, ý thức chân chính (Chánh niệm); vi. sammā-samādhi, định chân chính (Chánh định). III. Paññā, trí tuệ, tuệ giác hoàn toàn thanh lọc được tâm: vii. sammā-saṅkappa, suy nghĩ chân chính (Chánh tư duy); viii. sammā-diṭṭhi, sự hiểu biết chân chính (Chánh kiến). Magga là Sự Thật Thánh Thiện Thứ Tư (Đạo Đế) trong Bốn Sự Thật Thánh Thiện. Xem sacca.",
    "explain": ""
  },
  {
    "id": "Pali - 1336",
    "pali": "Mahāyāna",
    "vietnamese": "nghĩa đen, “chiếc xe lớn” (đại thừa). Tông phái Phật giáo phát triển tại Ấn Độ vài thế kỷ sau thời của Đức Phật và truyền sang phía bắc như Tây Tạng, Trung Quốc, Việt Nam, Mông Cổ, Hàn Quốc, và Nhật Bản.",
    "explain": ""
  },
  {
    "id": "Pali - 1337",
    "pali": "Mettā",
    "vietnamese": "tâm từ, tình thương vô vị lợi và thiện chí. Một trong những phẩm chất của một tâm thanh tịnh (xem Brahma-vihāra); một trong các pāramī. Mettā-bhāvanā, sự trau dồi Mettā một cách hệ thống bằng phương pháp thiền (từ bi quán).",
    "explain": ""
  },
  {
    "id": "Pali - 1338",
    "pali": "Moha",
    "vietnamese": "si, mê lầm, ảo tưởng. Đồng nghĩa với avijjā. Cùng với rāga và dosa, một trong ba phiền não chính trong tâm.",
    "explain": ""
  },
  {
    "id": "Pali - 1339",
    "pali": "Nāma",
    "vietnamese": "tâm, tinh thần (danh). Nāma-rūpa, tâm và thân, thể thống nhất thân-tâm (danh sắc). Nāma-rūpa viccheda, sự tách rời của thân và tâm khi chết, hay khi chứng nghiệm được nibbāna.",
    "explain": ""
  },
  {
    "id": "Pali - 1340",
    "pali": "Nibbāna",
    "vietnamese": "tịch diệt; giải thoát; sự thật tối hậu; diệt hết các nhân duyên (Niết bàn). (Sanskrit nirvāṇa)",
    "explain": ""
  },
  {
    "id": "Pali - 1341",
    "pali": "Nīvaraṇa",
    "vietnamese": "chướng ngại, trở ngại (triền cái). Năm trở ngại trong việc phát triển tâm trí là tham (kāmacchanda), sân (vyāpāda), uể oải về thể xác và tinh thần (hôn trầm, thụy miên) (thīna-middha), bồn chồn, bất an (trạo hối/trạo cử) (uddhacca-kukkucca), nghi ngờ (nghi) (vicikicchā).",
    "explain": ""
  },
  {
    "id": "Pali - 1342",
    "pali": "Oḷārika",
    "vietnamese": "thô thiển, thô. Trái nghĩa sukkuma.",
    "explain": ""
  },
  {
    "id": "Pali - 1343",
    "pali": "Pāli",
    "vietnamese": "câu chữ, bản văn; kinh sách ghi lại giáo huấn của Đức Phật; do đó là ngôn ngữ trong những kinh sách này. Chứng tích về mặt lịch sử, ngôn ngữ, khảo cổ cho thấy đó là một ngôn ngữ đích thực được nói ở miền bắc Ấn Độ vào thời hoặc gần thời của Đức Phật. Sau đó những kinh sách này được dịch sang tiếng Sanskrit là ngôn ngữ chỉ dùng trong văn chương.",
    "explain": ""
  },
  {
    "id": "Pali - 1344",
    "pali": "Paññā",
    "vietnamese": "trí tuệ, tuệ. Phần thứ ba trong ba sự rèn luyện khi tu tập Bát Chánh Đạo (xem magga). Có ba loại trí tuệ: Tuệ thụ nhận, trí tuệ do nghe, đọc từ người khác (Văn tuệ) (suta-mayā paññā); Tuệ tư duy, trí tuệ do lý luận (Tư tuệ) (cintā-mayā paññā); Tuệ giác, tuệ thực chứng, trí tuệ do tự chứng nghiệm (Tu tuệ) (bhāvanā-mayā paññā). Trong ba tuệ này, chỉ có tuệ cuối cùng mới có thể hoàn toàn thanh lọc được tâm; nó được trau dồi nhờ tu tập vipassanā-bhāvanā. Trí tuệ là một trong năm sức mạnh của tâm (xem bala), một trong bảy nhân tố giác ngộ (xem bojjhaṅga), và là một trong mười pāramī.",
    "explain": ""
  },
  {
    "id": "Pali - 1345",
    "pali": "Pāramī / pāramitā",
    "vietnamese": "sự hoàn hảo, phẩm hạnh (ba la mật); phẩm chất toàn thiện trong tâm giúp làm tan rã bản ngã và do đó đưa tới sự giải thoát. Mười pāramī/ phẩm hạnh là: hiến tặng (dāna), giới (sīla), xuất ly / xuất gia (nekkhamma), trí tuệ (paññā), nỗ lực / tinh tấn (viriya), kham nhẫn (khanti), chân thật (sacca), quyết tâm (adhiṭṭhāna), tâm từ (mettā), tâm xả (upekkhā).",
    "explain": ""
  },
  {
    "id": "Pali - 1346",
    "pali": "Paṭicca samuppāda",
    "vietnamese": "Chuỗi Duyên Khởi / Lý Duyên Khởi / Chuỗi 12 Nhân Duyên; nguồn gốc nhân quả. Tiến trình này, bắt đầu bằng vô minh, làm ta tiếp tục làm cho mình khổ đau hết kiếp này sang kiếp khác.",
    "explain": ""
  },
  {
    "id": "Pali - 1347",
    "pali": "Pūjā",
    "vietnamese": "tôn kính, tôn thờ, nghi thức hoặc nghi lễ tôn giáo. Đức Phật dạy rằng chỉ có một pūjā đúng cách duy nhất để tôn vinh Ngài là thực sự thực hành những lời dạy của Ngài, từ bước đầu tiên cho đến đích cuối cùng.",
    "explain": ""
  },
  {
    "id": "Pali - 1348",
    "pali": "Puññā",
    "vietnamese": "đức hạnh; hành động mang lại công đức, nhờ thực hành điều này ta đạt được hạnh phúc trong hiện tại và trong tương lai. Đối với một cư sĩ, puññā gồm có sự hiến tặng / cúng dường (dāna), sống một cuộc sống có giới hạnh (sīla), và thực hành thiền (bhāvanā).",
    "explain": ""
  },
  {
    "id": "Pali - 1349",
    "pali": "Rāga",
    "vietnamese": "tâm tham. Cùng với dosa và moha, một trong ba phiền não chính trong tâm. Đồng nghĩa với lobha.",
    "explain": ""
  },
  {
    "id": "Pali - 1350",
    "pali": "Ratana",
    "vietnamese": "châu bảo, châu báu. Ti-ratana: Tam bảo Phật, Pháp, Tăng.",
    "explain": ""
  },
  {
    "id": "Pali - 1351",
    "pali": "Rūpa",
    "vietnamese": "1. vật chất (sắc); 2. đối tượng của mắt. Xem āyatana, khandha.",
    "explain": ""
  },
  {
    "id": "Pali - 1352",
    "pali": "Sacca",
    "vietnamese": "chân lý, sự thật. Bốn Sự Thật Thánh Thiện (Tứ Diệu Đế) (ariya-sacca) là: Sự Thật về khổ (dukkha-sacca); (Khổ Đế) Sự Thật về nguyên nhân của khổ (samudaya-sacca); (Tập Đế) Sự Thật về sự đoạn diệt khổ (nirodha-sacca); (Diệt Đế) Sự Thật về con đường dẫn đến sự đoạn diệt khổ (magga-sacca) (Đạo Đế)",
    "explain": ""
  },
  {
    "id": "Pali - 1353",
    "pali": "Sādhu",
    "vietnamese": "“lành thay!”, làm giỏi; nói hay. Một cách diễn đạt sự đồng ý, tán đồng.",
    "explain": ""
  },
  {
    "id": "Pali - 1354",
    "pali": "Samatha",
    "vietnamese": "sự an tĩnh, sự tĩnh lặng. Samatha-bhāvanā, sự phát triển tâm tĩnh lặng, đồng nghĩa với samādhi. Xem bhāvanā.",
    "explain": ""
  },
  {
    "id": "Pali - 1355",
    "pali": "Sampajāna",
    "vietnamese": "có sampajañña. Xem dưới đây.",
    "explain": ""
  },
  {
    "id": "Pali - 1356",
    "pali": "Sampajañña",
    "vietnamese": "hiểu biết về toàn thể hiện tượng thân và tâm, có nghĩa là có tuệ giác về tính chất vô thường của hiện tượng này ở mức độ cảm giác.",
    "explain": ""
  },
  {
    "id": "Pali - 1357",
    "pali": "Samādhi",
    "vietnamese": "định, sự kiểm soát được tâm mình. Phần thứ hai trong ba phần rèn luyện để thực hành Bát Chánh Đạo (xem magga). Khi lấy phần này làm đích đến để tu tập sẽ đưa tới trạng thái nhập định (jhāna), nhưng không phải là sự giải thoát hoàn toàn của tâm. Ba loại samādhi là: 1. khaṇika samādhi, định trong khoảnh khắc, định được duy trì từ khoảnh khắc này sang khoảnh khắc khác (sát na định); 2. upacāra samādhi, sự định tâm ở một mức độ tiếp cận (đi dần đến) trạng thái nhập định (cận định); 3. appanā samādhi, sự tập trung hoàn toàn, trạng thái nhập định (jhāna). Trong những loại định này, khaṇika samādhi là sự chuẩn bị vừa đủ để có thể bắt đầu tu tập Vipassana",
    "explain": ""
  },
  {
    "id": "Pali - 1358",
    "pali": "Saṃsāra",
    "vietnamese": "vòng luân hồi, tái sinh; thế giới hữu vi; thế giới khổ đau.",
    "explain": ""
  },
  {
    "id": "Pali - 1359",
    "pali": "Samudaya",
    "vietnamese": "nảy sinh, nguồn gốc. Samudaya-dhamma, hiện tượng nảy sinh. Samudaya-sacca, Sự Thật về nguồn gốc của khổ, Sự Thật Thứ Hai (Tập Đế) trong Bốn Sự Thật Thánh Thiện (Tứ Diệu Đế).",
    "explain": ""
  },
  {
    "id": "Pali - 1360",
    "pali": "Saraṇa",
    "vietnamese": "sự trú ẩn, nương tựa, bảo vệ (quy y). Ti-sarana: nương tựa hay quy y Tam bảo, có nghĩa là nương tựa vào Phật, Pháp, Tăng.",
    "explain": ""
  },
  {
    "id": "Pali - 1361",
    "pali": "Saṅgha",
    "vietnamese": "nhóm; cộng đồng của ariyā, ví dụ như là những người đã chứng nghiệm được nibbāna; cộng đồng Tăng, Ni Phật giáo; một thành viên của ariya-saṅgha, bhikkhu-saṅgha hoặc bhikkhunī-saṅgha.",
    "explain": ""
  },
  {
    "id": "Pali - 1362",
    "pali": "Saṅkhāra",
    "vietnamese": "sự hình thành (trong tâm), (hành); hành động có dụng ý; phản ứng của tâm; sự điều kiện hóa tâm. Một trong năm tập hợp (khandha), cũng là mắt xích thứ hai trong Chuỗi Duyên Khởi (paṭicca samuppāda). Saṅkhāra là kamma, hành động mang lại hậu quả trong tương lai và do đó thực sự có trách nhiệm tạo nên cuộc đời mai sau. (Sanskrit saṃskāra).",
    "explain": ""
  },
  {
    "id": "Pali - 1363",
    "pali": "Saṅkhārupekkhā",
    "vietnamese": "nghĩa đen, tâm xả đối với saṅkhārā. Một giai đoạn trong sự tu tập Vipassana, xảy ra sau việc kinh nghiệm được bhaṅga, giai đoạn khi những bất tịnh lâu đời ẩn sâu trong vô thức nổi lên bề mặt của tâm và thể hiện ra bằng những cảm giác. Bằng cách duy trì được tâm xả (upekkhā) trước những cảm giác này, thiền giả không tạo ra saṅkhārā mới và để cho những saṅkhārā cũ diệt đi. Do đó tiến trình này dần dần đưa đến sự diệt trừ hết mọi saṅkhārā.",
    "explain": ""
  },
  {
    "id": "Pali - 1364",
    "pali": "Sato",
    "vietnamese": "ý thức, nhận biết. Sato sampajāno: ý thức với sự hiểu biết về bản chất vô thường của toàn thể cấu trúc tinh thần-vật chất, bằng cách quan sát cảm giác.",
    "explain": ""
  },
  {
    "id": "Pali - 1365",
    "pali": "Saññā",
    "vietnamese": "(trong samyutta-ñāṇā, sự hiểu biết đã bị điều kiện hóa) nhận định, nhận biết, tri giác, tưởng. Một trong năm tập hợp (khandha). Nó thường bị chi phối bởi saṅkhārā trong quá khứ của ta và do đó đưa đến một hình ảnh lệch lạc về sự thật. Trong khi tu tập Vipassana, saññā được chuyển thành paññā, sự hiểu biết thực tại đúng như thật. Nó trở thành anicca-saññā, dukkha-saññā, asubha-saññā — đó là, sự nhận định về vô thường, khổ, vô ngã, và tính chất hư ảo của vẻ đẹp vật chất.",
    "explain": ""
  },
  {
    "id": "Pali - 1366",
    "pali": "Sati",
    "vietnamese": "ý thức, nhận biết (niệm). Một phần trong Bát Chánh Đạo (xem magga), cũng là một trong năm sức mạnh của tâm (xem bala) và bảy nhân tố giác ngộ (xem bojjhaṅga). Ānāpāna-Sati, ý thức về hơi thở. (quán hơi thở)",
    "explain": ""
  },
  {
    "id": "Pali - 1367",
    "pali": "Siddhattha",
    "vietnamese": "nghĩa đen, ‘người đã hoàn thành nhiệm vụ của mình’. Tên riêng của vị Phật lịch sử. (Sanskrit Siddhārtha).",
    "explain": ""
  },
  {
    "id": "Pali - 1368",
    "pali": "Sīla",
    "vietnamese": "đạo đức, giới; tránh những hành động bằng lời nói và việc làm gây hại cho mình và cho người khác. Phần đầu trong ba sự tập luyện trong sự thực hành Bát Thánh Đạo (xem magga). Đối với một cư sĩ, sīla được thực hành trong đời sống hằng ngày bằng cách giữ Năm Giới.",
    "explain": ""
  },
  {
    "id": "Pali - 1369",
    "pali": "Satipaṭṭhāna",
    "vietnamese": "Sự Thiết Lập Vững Chắc Ý Thức (Tứ Niệm Xứ, bốn lĩnh vực chú tâm để phát triển vững chắc sự nhận biết). Có bốn lĩnh vực tương quan của satipaṭṭhāna: 1. quan sát thân (quán thân) (kāyānupassanā); 2. quan sát cảm giác nảy sinh trên thân (quán thọ) (vedanānupassanā); 3. quan sát tâm (quán tâm) (cittānupassanā); 4. quan sát nội dung của tâm (quán pháp) (dhammānupassanā). Cả bốn phần đều bao gồm quan sát cảm giác, bởi vì cảm giác liên quan trực tiếp đến thân cũng như tâm. Mahā-Satipaṭṭhāna Suttanta (Dīgha Nikāya, 22), Trường Kinh về Sự Thiết Lập Vững Chắc Ý Thức (Đại Niệm Xứ), là nguồn tư liệu chính mà trong đó lý thuyết căn bản cho việc tu tập vipassanā-bhāvanā được giảng giải.",
    "explain": ""
  },
  {
    "id": "Pali - 1370",
    "pali": "Sotāpanna",
    "vietnamese": "người đã đạt đến giai đoạn đầu của bậc thánh, và đã chứng nghiệm được Nibbāna. Xem ariya.",
    "explain": ""
  },
  {
    "id": "Pali - 1371",
    "pali": "Sukha",
    "vietnamese": "niềm vui sướng, hạnh phúc. Trái nghĩa với dukkha.",
    "explain": ""
  },
  {
    "id": "Pali - 1372",
    "pali": "Sukhuma",
    "vietnamese": "vi tế, tinh tế. Trái nghĩa oḷārika.",
    "explain": ""
  },
  {
    "id": "Pali - 1373",
    "pali": "Suta-Mayā Paññā",
    "vietnamese": "nghĩa đen, trí tuệ đạt được nhờ nghe từ người khác. Tuệ thụ nhận, trí tuệ do học hỏi (văn tuệ). Xem paññā.",
    "explain": ""
  },
  {
    "id": "Pali - 1374",
    "pali": "Sutavā / Sutavant",
    "vietnamese": "được chỉ dạy, người đã được nghe dạy về sự thật (thanh văn), người có suta-mayā-paññā. Trái nghĩa assutavā.",
    "explain": ""
  },
  {
    "id": "Pali - 1375",
    "pali": "Sutta",
    "vietnamese": "kinh Phật / bài giảng của Đức Phật hoặc của một trong những đệ tử chính của Ngài. (Sanskrit sutra).",
    "explain": ""
  },
  {
    "id": "Pali - 1376",
    "pali": "Taṇhā",
    "vietnamese": "nghĩa đen, ‘sự khát / thèm khát’, tham ái. Bao gồm cả tham lẫn sân là mặt trái của tham. Đức Phật chỉ rõ taṇhā là nguồn gốc của khổ (samudaya-sacca) trong bài giảng đầu tiên, “Kinh Chuyển Bánh Xe Dhamma” (Kinh Chuyển Pháp Luân) (Dhammacakkappavattana Sutta). Trong Chuỗi Duyên Khởi (paṭicca Samuppāda) Ngài giải thích rằng taṇhā phát nguồn từ một sự phản ứng nào đó đối với cảm giác trên thân.",
    "explain": ""
  },
  {
    "id": "Pali - 1377",
    "pali": "Tathāgata",
    "vietnamese": "nghĩa đen, ‘đi như thế’ hoặc ‘đến như thế’ (Như lai). Người nhờ đi trên con đường sự thật đã đạt được sự thật tối hậu, có nghĩa là một người giác ngộ. Danh xưng Đức Phật thường dùng để chỉ về bản thân.",
    "explain": ""
  },
  {
    "id": "Pali - 1378",
    "pali": "Theravāda",
    "vietnamese": "nghĩa đen, ‘giáo huấn của bậc trưởng lão’. Giáo huấn của Đức Phật, theo thể thức đã được bảo tồn tại các nước ở Nam Á (Myanmar, Sri Lanka, Thái Lan, Lào, Cam-pu-chia). Thường được công nhận là thể thức cổ xưa nhất của giáo pháp (Phật Giáo Nguyên Thủy).",
    "explain": ""
  },
  {
    "id": "Pali - 1379",
    "pali": "Ti-lakkhaṇa",
    "vietnamese": "Xem lakkhaṇa.",
    "explain": ""
  },
  {
    "id": "Pali - 1380",
    "pali": "Tipiṭaka",
    "vietnamese": "nghĩa đen, ba giỏ chứa (tam tạng). Ba bộ sưu tập về giáo lý của Đức Phật là: 1. Vinaya-piṭaka, bộ luật, bộ sưu tập về giới luật cho Tăng, Ni; 2. Sutta piṭaka, bộ kinh, bộ sưu tập những bài giảng; 3. Abhidhamma-piṭaka, bộ luận, bộ sưu tập những giáo lý cao hơn, nghĩa là sự bình luận về Dhamma một cách triết lý và có hệ thống. (Sanskrit Tripiṭaka)",
    "explain": ""
  },
  {
    "id": "Pali - 1381",
    "pali": "Ti-Ratana",
    "vietnamese": "xem ratana",
    "explain": ""
  },
  {
    "id": "Pali - 1382",
    "pali": "Udaya",
    "vietnamese": "nảy sinh, sinh, khởi. Udayabbaya, sinh và diệt, nghĩa là vô thường (cũng là udaya-vaya). Sự hiểu biết bằng kinh nghiệm về sự thật này đạt được bằng cách quan sát các cảm giác thay đổi không ngừng nơi chính mình.",
    "explain": ""
  },
  {
    "id": "Pali - 1383",
    "pali": "Upādāna",
    "vietnamese": "dính mắc, ràng buộc, bám víu, giữ chặt (thủ).",
    "explain": ""
  },
  {
    "id": "Pali - 1384",
    "pali": "Upekkha",
    "vietnamese": "tâm xả (xả); trạng thái của tâm không có tham, sân, si. Một trong bốn trạng thái thuần khiết của tâm. (xem Brahma-vihāra), trong bảy nhân tố giác ngộ (xem bojjhaṅga), và mười pāramī.",
    "explain": ""
  },
  {
    "id": "Pali - 1385",
    "pali": "Uppāda",
    "vietnamese": "xuất hiện, nảy sinh, sinh. Uppāda-vaya, sinh và diệt. Uppāda-vaya-dhammino, có bản chất của sinh và diệt.",
    "explain": ""
  },
  {
    "id": "Pali - 1386",
    "pali": "Vaya / Vyaya",
    "vietnamese": "diệt đi / diệt mất, suy tàn. Vaya-dhamma hiện tượng tan diệt mất.",
    "explain": ""
  },
  {
    "id": "Pali - 1387",
    "pali": "Vedanā",
    "vietnamese": "cảm nhận / cảm giác (thọ). Một trong năm tập hợp (khandha). Vedanā được Đức Phật mô tả là có 2 lĩnh vực thuộc về tinh thần và vật chất; do đó vedanā cho ta phương tiện khảo sát toàn thể hiện tượng tinh thần-vật chất. Trong Chuỗi Duyên Khởi (paṭicca-samuppāda), Đức Phật giải thích rằng taṇhā, nguồn gốc của khổ, nảy sinh là do phản ứng đối với vedanā. Bằng cách tập quan sát vedanā một cách khách quan ta có thể tránh khỏi bất cứ phản ứng mới nào, và có thể kinh nghiệm trực tiếp trong bản thân sự thật về vô thường (anicca). Kinh nghiệm này là thiết yếu để phát triển sự xa lìa những dính mắc, đưa đến sự giải thoát cho tâm.",
    "explain": ""
